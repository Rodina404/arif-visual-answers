# --- LLM ---
LLM_PROVIDER=gemini            # gemini | openai_compat | mock
GEMINI_API_KEY=                # server-side only; never commit
MODEL=gemini-3.8-flash         # verify with `make check-models`
FALLBACK_MODEL=gemini-3.1-flash-lite
THINKING_LEVEL=low             # minimal | low | medium | high
MEDIA_RESOLUTION=medium
SCHEMA_MODE=json               # json (schema in prompt, default) | flat | single | plan
MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_S=45
ENABLE_EXPLICIT_CACHE=0
PROMPT_VERSION=v1
# --- self-hosted option ---
OPENAI_COMPAT_BASE_URL=http://localhost:8001/v1
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=
# --- mock / testing ---
MOCK_LLM=0
MOCK_DELAY_MS=30
MOCK_TTFT_MS=400
LOG_RAW_OUTPUT=0
# --- limits & security ---
MAX_UPLOAD_MB=20
MAX_PAGES=60
MAX_QUESTIONS_PER_DOC=50
RATE_LIMIT_ASK=10/minute
RATE_LIMIT_UPLOAD=5/minute
CORS_ORIGINS=http://localhost:5173
DIGITS=latn                    # latn | arab (display only)
